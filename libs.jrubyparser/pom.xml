<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.piotrhoppe.org.netbeans.modules.ruby</groupId>
        <artifactId>community-ruby</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>io.github.piotrhoppe.org.netbeans.modules.ruby</groupId>
    <artifactId>jrubyparser</artifactId>
    <packaging>nbm</packaging>

    <name>libs.jrubyparser</name>

    <repositories>
<!--        <repository>
            <id>github-jruby-parser</id>
            <url>https://github.com/piotrhoppe/jruby-parser</url>
        </repository>-->
        <repository>
            <id>lib_id</id>
            <url>file://${project.basedir}/lib</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <publicPackages>
                        <publicPackage>org.jrubyparser</publicPackage>
                        <publicPackage>org.jrubyparser.ast</publicPackage>
                        <publicPackage>org.jrubyparser.lexer</publicPackage>
                        <publicPackage>org.jrubyparser.parser</publicPackage>
                        <publicPackage>org.jrubyparser.rewriter</publicPackage>
                        <publicPackage>org.jrubyparser.rewriter.utils</publicPackage>
                        <publicPackage>org.jrubyparser.util</publicPackage>
                        <publicPackage>org.jrubyparser.util.diff</publicPackage>
                    </publicPackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadoc-placeholder</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classesDirectory>${project.basedir}/src/central-javadoc</classesDirectory>
                                    <classifier>javadoc</classifier>
                                    <includes>
                                        <include>README.md</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.jruby</groupId>
            <artifactId>jrubyparser</artifactId>
            <version>0.6.0</version>
        </dependency>
<!--        <dependency>
            <groupId>org.jruby</groupId>
            <artifactId>jrubyparser</artifactId>
            <version>0.5.5-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${basedir}/lib/jrubyparser-0.5.5-SNAPSHOT.jar</systemPath>
        </dependency>-->
    </dependencies>
</project>
